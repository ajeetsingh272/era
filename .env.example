# Public URL of the site (used for canonical URLs, sitemap, Open Graph). Can also be changed in Admin → SEO.
SITE_URL=https://www.example.com

# SQLite database file (created automatically on first run)
DATABASE_PATH=./data/era.db
# Where admin-uploaded images are stored (served at /uploads/...). Back up with the database.
UPLOAD_DIR=./data/uploads

# First admin account – created automatically on first start if no admin exists.
# Change the password after first login (Admin → Settings).
ADMIN_EMAIL=admin@erainterior.in
ADMIN_PASSWORD=change-me-now-please
